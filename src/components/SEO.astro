---
import { htmlLang, localizePath, locales, ogLocale, type Locale } from '@/i18n';
import { profile } from '@/data/profile';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-independent path of the page, e.g. `/` or `/projects/florasense`. */
  path: string;
  /** Absolute path of the Open Graph image inside /public. */
  image?: string | undefined;
  imageAlt?: string | undefined;
  type?: 'website' | 'article' | 'profile' | undefined;
  noindex?: boolean | undefined;
}

const {
  locale,
  title,
  description,
  path,
  image = `/og/home-${locale}.png`,
  imageAlt = title,
  type = 'website',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://pedrodcarvalho.github.io');
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(localizePath(path, locale));
const alternates = locales.map((l) => ({
  hreflang: htmlLang[l],
  href: abs(localizePath(path, l)),
}));
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={a.href} />
))}
<link rel="alternate" hreflang="x-default" href={abs(localizePath(path, 'en'))} />
{noindex && <meta name="robots" content="noindex" />}

<meta name="author" content={profile.name} />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[locale]} />
{locales
  .filter((l) => l !== locale)
  .map((l) => (
    <meta property="og:locale:alternate" content={ogLocale[l]} />
  ))}
<meta property="og:image" content={abs(image)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={abs(image)} />
