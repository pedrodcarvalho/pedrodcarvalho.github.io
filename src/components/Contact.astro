---
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '@/i18n';
import { cv, profile } from '@/data/profile';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__panel card" data-reveal>
      <div class="contact__glow" aria-hidden="true"></div>
      <p class="eyebrow contact__eyebrow">{t('contact.eyebrow')}</p>
      <h2 id="contact-title" class="contact__title">
        {t('contact.title.a')}
        <span class="contact__accent">{t('contact.title.b')}</span>
      </h2>
      <p class="contact__lede">{t('contact.lede')}</p>

      <div class="contact__email">
        <a class="contact__address" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={22} />
          <span>{profile.email}</span>
        </a>
        <button
          class="btn"
          type="button"
          data-copy={profile.email}
          data-copied-label={t('contact.copied')}
        >
          <Icon name="copy" class="copy-icon" />
          {t('contact.copy')}
        </button>
      </div>

      <ul role="list" class="contact__links">
        <li>
          <a class="btn btn--primary" href={profile.links.linkedin} target="_blank" rel="noopener">
            <Icon name="linkedin" />
            LinkedIn
            <span class="sr-only">({t('a11y.external')})</span>
          </a>
        </li>
        <li>
          <a class="btn" href={profile.links.github} target="_blank" rel="noopener">
            <Icon name="github" />
            GitHub
            <span class="sr-only">({t('a11y.external')})</span>
          </a>
        </li>
        <li>
          <a class="btn btn--ghost" href={cv.en.href} download hreflang="en">
            <Icon name="file" />
            {t('contact.cvEn')}
          </a>
        </li>
        <li>
          <a class="btn btn--ghost" href={cv.pt.href} download hreflang="pt-BR">
            <Icon name="file" />
            {t('contact.cvPt')}
          </a>
        </li>
      </ul>

      <p class="contact__loc mono">
        <Icon name="map-pin" size={14} />
        {t('contact.location')}
      </p>
    </div>
  </div>
</section>

<style>
  .contact__panel {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-m);
    padding: clamp(2.5rem, 2rem + 5vw, 6rem) var(--gutter);
    border-radius: calc(var(--radius-l) + 8px);
    background: var(--bg-elev-1);
  }
  .contact__glow {
    position: absolute;
    inset: auto 10% -40% 10%;
    height: 80%;
    z-index: -1;
    background: radial-gradient(ellipse at center, var(--accent-glow), transparent 65%);
    filter: blur(40px);
    opacity: 0.6;
    pointer-events: none;
  }
  .contact__eyebrow {
    color: var(--accent);
  }
  .contact__title {
    font-size: var(--step-5);
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 16ch;
  }
  .contact__accent {
    display: block;
    color: var(--accent-display);
  }
  .contact__lede {
    max-width: 40rem;
    color: var(--fg-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .contact__email {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-xs);
  }
  .contact__address {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.2rem;
    transition:
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
    overflow-wrap: anywhere;
  }
  .contact__address:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
  }
  .contact__loc {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--2);
    color: var(--fg-subtle);
  }
  @media (max-width: 420px) {
    .contact__address {
      font-size: var(--step-1);
    }
  }
</style>
