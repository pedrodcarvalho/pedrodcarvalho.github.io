---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import { localizePath, useTranslations, type Locale } from '@/i18n';
import { getProjects, projectSlug, type Project } from '@/lib/projects';
import { profile } from '@/data/profile';

interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(project);
const slug = projectSlug(project);
const all = await getProjects(locale);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length]!;
const home = localizePath('/', locale);
const d = project.data;
---

<Base
  locale={locale}
  path={`/projects/${slug}`}
  title={`${d.title} · ${d.tagline} | ${profile.name}`}
  description={d.summary}
  image={`/og/${slug}-${locale}.png`}
  type="article"
>
  <article class="cs">
    <header class="cs__head container">
      <a class="cs__back mono" href={`${home}#projects`}>
        <Icon name="arrow-left" size={14} />
        {t('case.back')}
      </a>
      <p class="cs__meta mono" data-hero-item>
        {d.badge && <span class="cs__badge">{d.badge}</span>}
        <span>{d.tagline}</span>
      </p>
      <h1 class="cs__title" data-hero-title>
        {d.title}
      </h1>
      <p class="cs__summary" data-hero-item>
        {d.summary}
      </p>
    </header>

    <div class="container">
      <div class="cs__visual card">
        <ProjectVisual visual={d.visual} live />
      </div>

      <dl class="cs__facts" data-reveal>
        <div>
          <dt class="eyebrow">{t('case.role')}</dt>
          <dd>{d.role}</dd>
        </div>
        <div>
          <dt class="eyebrow">{t('case.year')}</dt>
          <dd class="mono">{d.year}</dd>
        </div>
        <div class="cs__facts-stack">
          <dt class="eyebrow">{t('case.stack')}</dt>
          <dd>
            <ul role="list" class="cs__stack">
              {d.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </dd>
        </div>
        <div>
          <dt class="eyebrow">{t('case.links')}</dt>
          <dd>
            <a class="link cs__repo" href={d.repo} target="_blank" rel="noopener">
              <Icon name="github" size={16} />
              {t('case.repo')}
              <span class="sr-only">({t('a11y.external')})</span>
            </a>
          </dd>
        </div>
      </dl>

      {d.stats.length > 0 && (
        <ul role="list" class="cs__stats" data-reveal>
          {d.stats.map((s) => (
            <li>
              <p class="cs__stat-value">{s.value}</p>
              <p class="cs__stat-label">{s.label}</p>
            </li>
          ))}
        </ul>
      )}

      <div class="cs__body prose" data-reveal>
        <Content />
      </div>

      <a class="cs__next card" href={localizePath(`/projects/${projectSlug(next)}`, locale)}>
        <span class="eyebrow">{t('case.next')}</span>
        <span class="cs__next-title">
          {next.data.title}
          <Icon name="arrow-right" size={24} />
        </span>
        <span class="cs__next-tag">{next.data.tagline}</span>
      </a>
    </div>
  </article>
</Base>

<style>
  .cs {
    padding-top: calc(var(--nav-h) + var(--space-xl));
    padding-bottom: var(--space-3xl);
  }
  .cs__head {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    margin-bottom: var(--space-xl);
  }
  .cs__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--fg-muted);
    margin-bottom: var(--space-m);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .cs__back:hover {
    color: var(--accent);
  }
  .cs__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cs__badge {
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    background: var(--live-soft);
    color: var(--live);
    font-weight: 600;
  }
  .cs__title {
    font-size: var(--step-5);
    letter-spacing: -0.045em;
  }
  .cs__summary {
    max-width: 48rem;
    color: var(--fg-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .cs__visual {
    aspect-ratio: 16 / 7;
    border-radius: var(--radius-l);
  }
  .cs__facts {
    display: grid;
    grid-template-columns: 1fr auto 2fr 1fr;
    gap: var(--space-l);
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--line);
  }
  .cs__facts dd {
    margin-top: var(--space-2xs);
  }
  .cs__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .cs__repo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .cs__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .cs__stats li {
    padding: var(--space-l) var(--space-m) var(--space-l) 0;
  }
  .cs__stat-value {
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .cs__stat-label {
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .prose {
    max-width: 44rem;
    margin: var(--space-2xl) auto;
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--fg-muted);
  }
  .prose :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-s);
    font-size: var(--step-2);
    color: var(--fg);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p + p),
  .prose :global(p + ul),
  .prose :global(p + ol),
  .prose :global(ul + p),
  .prose :global(ol + p) {
    margin-top: var(--space-s);
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: var(--space-xs);
    padding-left: 1.25rem;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
  .prose :global(em) {
    color: var(--fg);
  }
  .prose :global(code) {
    padding: 0.1em 0.4em;
    border-radius: 5px;
    border: 1px solid var(--line);
    background: var(--bg-elev-1);
    color: var(--fg);
  }

  .cs__next {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-xl) var(--space-l);
    max-width: 44rem;
    margin-inline: auto;
  }
  .cs__next-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .cs__next-title :global(svg) {
    color: var(--accent);
    transition: transform var(--dur) var(--ease-out);
  }
  .cs__next:hover .cs__next-title :global(svg) {
    transform: translateX(6px);
  }
  .cs__next-tag {
    color: var(--fg-muted);
  }

  @media (max-width: 860px) {
    .cs__facts {
      grid-template-columns: 1fr 1fr;
    }
    .cs__facts-stack {
      grid-column: 1 / -1;
      order: 3;
    }
    .cs__visual {
      aspect-ratio: 16 / 10;
    }
  }
</style>
