---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
}
const { id, eyebrow, title, lede } = Astro.props;
---

<header class="section-head" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="section-title">
    {title}
  </h2>
  {lede && <p class="section-lede">{lede}</p>}
</header>
